<Window x:Class="WPF01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF01"
        mc:Ignorable="d"
        Title="用户登录" Height="350" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F0F2F5">
        <!-- 登录面板 -->
        <Border Background="White" CornerRadius="8" Padding="30"
                Width="360" Height="280"
                Effect="{DynamicResource shadow}">
            <StackPanel VerticalAlignment="Center">
                <!-- 标题 -->
                <TextBlock Text="系统登录" FontSize="22" FontWeight="Bold"
                           Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- 用户名 -->
                <TextBlock Text="用户名" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                <TextBox x:Name="txtUsername" Height="34" FontSize="14"
                         Padding="8,0" BorderBrush="#D9D9D9" BorderThickness="1"/>

                <!-- 密码 -->
                <TextBlock Text="密码" FontSize="13" Foreground="#555" Margin="0,14,0,4"/>
                <PasswordBox x:Name="txtPassword" Height="34" FontSize="14"
                             Padding="8,0" BorderBrush="#D9D9D9" BorderThickness="1"/>

                <!-- 错误提示 -->
                <TextBlock x:Name="txtError" Foreground="#E74C3C" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>

                <!-- 登录按钮 -->
                <Button x:Name="btnLogin" Content="登  录" Height="38"
                        FontSize="15" FontWeight="Bold"
                        Background="#1890FF" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,18,0,0"
                        Click="BtnLogin_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
