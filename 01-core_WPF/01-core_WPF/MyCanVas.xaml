<Window x:Class="_01_core_WPF.MyCanVas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Title="MyCanVas" Height="450" Width="800">
    <!--<Canvas>
        <Button Canvas.Right="0"  Content="bt1" />
        <Button Canvas.Bottom="0" Content="bt2" />
        <Button Canvas.Top="20" Content="bt3" />
        <Button Margin="100" Content="bt4" />
        <Button Canvas.Bottom="100" Content="bt5" />
        <Button Content="bt6" />
    </Canvas>-->
    <Canvas>
        <!-- 绘制一个可移动的圆形 -->
            
            <Ellipse x:Name="circle" Width="50" Height="50" Fill="Red"
Canvas.Left="0" Canvas.Top="100">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <!--动画：从左到右移动-->
                                <DoubleAnimation
Storyboard.TargetName="circle"
Storyboard.TargetProperty="(Canvas.Left)"
From="0" To="300" Duration="0:0:2" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
    </Canvas>
</Window>
