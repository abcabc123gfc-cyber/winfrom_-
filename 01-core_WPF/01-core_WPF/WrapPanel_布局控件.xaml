        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Title="WrapPanel_布局控件" Height="468" Width="225">
    <WrapPanel Margin="0,0,10,-5">
        <!--WrapPanel: 可以自动换行-->
        <TextBlock Text="文本1" Margin="10" FontSize="20"></TextBlock>
        <TextBlock Text="文本2"  Margin="10" FontSize="20"></TextBlock>
        <TextBlock Text="文本3" Margin="10" FontSize="20"></TextBlock>
        <TextBlock Text="文本4" Margin="10" FontSize="20"></TextBlock>
        <TextBlock Text="文本5" Margin="10"  FontSize="20"></TextBlock>
    </WrapPanel>
</Window>
