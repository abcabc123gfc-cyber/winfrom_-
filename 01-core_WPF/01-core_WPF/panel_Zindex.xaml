<Window x:Class="_01_core_WPF.panel_Zindex"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Title="panel_Zindex" Height="450" Width="800">
    <Grid PreviewMouseUp="Grid_PreviewMouseUp">

        <!-- PreviewMouseUp="Grid_PreviewMouseUp" 隧道事件-->
        <!--Grid默认一行一列-->
        <!--声明行-->
        <Grid.RowDefinitions>
            <RowDefinition ></RowDefinition>
            <RowDefinition ></RowDefinition>
        </Grid.RowDefinitions>
        <!--声明列-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!--空间默认情况下铺满窗体-->
        <!--默认自动放在 Row=0,Column=0-->
        <!--单元格也是从下标 0 开始的, 类似二维数组-->
        <!--Grid.RowSpan="2": 表明: 该控件占两行-->
        <Button Grid.RowSpan="2" Content="按钮2" Height="100" Width="100" ></Button>
        <!--Grid.ColumnSpan="2" 表明: 该控件占两列-->
        <Button  Grid.ColumnSpan="2"  Content="按钮1" Height="100" Width="100"  ></Button>

    </Grid>
</Window>
