<Window x:Class="_01_core_WPF.MyBorder布局控件"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Title="MyBorder布局控件" Height="450" Width="800">
   <Border>
       <!--只能放置一个子元素,通常会放一个其他布局控件-->
      <!--<TextBlock Text="Hello World" FontSize="20" Foreground="Red" />-->
       <StackPanel>
           <!--圆角值一般 :长加宽除以2-->
           <Border CornerRadius="5" Background="Yellow" BorderBrush="Red" BorderThickness="0 0 0 2" HorizontalAlignment="Center" Width="200" Height="100">
               <TextBlock Width="100" Height="30" Text="Hello World" FontSize="20" Foreground="Red" />
           </Border>
           
           <TextBlock Text="Hello World" FontSize="20" Foreground="Red" />
       </StackPanel>
   </Border>
</Window>
