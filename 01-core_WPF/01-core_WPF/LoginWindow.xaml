<Window x:Class="_01_core_WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Title="登录"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <!-- 引入外部资源字典（样式都在这里定义） -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CommonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Direction="270"
                              BlurRadius="15"
                              ShadowDepth="3"
                              Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Grid Grid.Row="0"
                  Height="60"
                  Background="{StaticResource PrimaryBrush}">
                <TextBlock Text="用户登录"
                           FontSize="20"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
                <Button Content="×"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="20"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- 中间登录表单 -->
            <StackPanel Grid.Row="1"
                        Margin="40,30,40,20"
                        VerticalAlignment="Center">

                <!-- 用户名 -->
                <TextBlock Text="用户名"
                           Style="{StaticResource FormLabelStyle}"/>
                <TextBox x:Name="txtUsername"
                         Style="{StaticResource FormTextBoxStyle}"
                         Margin="0,0,0,18"
                         Text="admin"/>

                <!-- 密码 -->
                <TextBlock Text="密码"
                           Style="{StaticResource FormLabelStyle}"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{StaticResource FormPasswordBoxStyle}"
                             Margin="0,0,0,10"
                             Password="123456"/>

                <!-- 错误提示 -->
                <TextBlock x:Name="txtError"
                           FontSize="12"
                           Foreground="{StaticResource ErrorBrush}"
                           Height="18"
                           Margin="0,0,0,15"/>

                <!-- 记住我 & 忘记密码 -->
                <Grid Margin="0,0,0,20">
                    <CheckBox x:Name="chkRemember"
                              Content="记住我"
                              FontSize="12"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="忘记密码？"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Cursor="Hand"/>
                </Grid>

                <!-- 登录按钮 -->
                <Button x:Name="btnLogin"
                        Content="登 录"
                        Style="{StaticResource PrimaryButtonStyle}"
                        FontSize="15"
                        Click="BtnLogin_Click"/>

                <!-- 注册 -->
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextHintBrush}">
                    <Run Text="还没有账号？"/>
                    <Run Text="立即注册"
                         Style="{StaticResource LinkTextStyle}"
                         Cursor="Hand"/>
                </TextBlock>
            </StackPanel>

            <!-- 底部版权 -->
            <TextBlock Grid.Row="2"
                       Text="© 2026 WPF Demo"
                       FontSize="11"
                       Foreground="{StaticResource TextHintBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>
        </Grid>
    </Border>
</Window>
