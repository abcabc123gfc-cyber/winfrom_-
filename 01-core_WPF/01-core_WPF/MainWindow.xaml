<Window x:Class="_01_core_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_01_core_WPF"
        mc:Ignorable="d"
        Icon="/images/icon.png"
        WindowStartupLocation="CenterScreen"
        Title="窗体常见属性" Height="450" Width="800">
        
    <StackPanel>
        <Button x:Name="btn"  Click="Button_Click" Width="190" Height="30" Style="{StaticResource btn-For}"> hello</Button>
        
        <!-- <标签名字 属性名="属性"> 内容</标签名字> -->
        <TextBlock  x:Name="text" Width="200"></TextBlock>
    </StackPanel>
</Window>
