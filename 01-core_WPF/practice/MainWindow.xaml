<Window x:Class="practice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:practice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <!--标题栏-->
        <StackPanel DockPanel.Dock="Top"  Height="80" Background="Teal">
            <Canvas >    
                
            <TextBlock Canvas.Top="20" Margin="20 0" Text="标题" FontSize="30" VerticalAlignment="Center"></TextBlock>
                <Border Margin="0 25" CornerRadius="10" Background="Blue" Canvas.Right="20" Height="30" Width="80" >
                    <TextBlock   VerticalAlignment="Center" HorizontalAlignment="Center" Text="退出"></TextBlock>
                    <!--<Button Canvas.Left="50" Canvas.Top="20" Content="按钮" Background="Red" Foreground="White" FontSize="20"></Button>-->
                </Border>
            </Canvas>
        </StackPanel>
        <!--菜单栏-->
        <StackPanel DockPanel.Dock="Left" Width="100" Background="AntiqueWhite">
            <TextBlock Margin="0 10 0 0" HorizontalAlignment="Center" Text="菜单栏" FontSize="20" Foreground="Red"></TextBlock>
        </StackPanel>
        <!--底部-->
        <StackPanel DockPanel.Dock="Bottom" Height="80" Background="Gray">
            
            <TextBlock FontSize="30" Height="20" Margin="0 30" VerticalAlignment="Center" HorizontalAlignment="Center" Text="底部文字"></TextBlock>
          
        </StackPanel>
        <!--主体区域-->
        <StackPanel   >
            <TextBlock Margin="10 20" Text="内容显示区域_主体" Foreground="Red"></TextBlock>
            <UniformGrid Columns="3" Height="100" Width="400" Background="Bisque">
                <Border Height="80" Width="120" Background="Teal" CornerRadius="10" >
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Border>
                <Border Height="80" Width="120" Background="Teal" CornerRadius="10" >
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        
                    <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Border>
                <Border Height="80" Width="120" Background="Teal" CornerRadius="10" >
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <TextBlock Text="卡片" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Border>

            </UniformGrid>
        </StackPanel>

    </DockPanel>
</Window>
