<Window
    x:Class="练习.MI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:练习"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MI"
    Width="1100"
    Height="800"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="labelSty" TargetType="Label">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            
        </Style>
    </Window.Resources>
    <Grid>
        <WrapPanel
            Height="50"
            Margin="0,0,0,0"
            VerticalAlignment="Top"
            Panel.ZIndex="10">
            <Label Width="30" Height="50" />
            <Label
                Width="70"
                Height="50"
                HorizontalContentAlignment="Left"
                VerticalContentAlignment="Center">
                <Image
                    Width="30"
                    Height="30"
                    Source="/Image/MILog.png" />
            </Label>
            <Label Width="80" />
            <WrapPanel>
                <Label
                    Content="小米官网"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="小米商场"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="80"
                    Content="小米澎湃OS"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="小米汽车"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="小米影像"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="云服务"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="40"
                    Content="loT"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="40"
                    Content="有品"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="90"
                    Content="小爱开放平台"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="Loction"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="80"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />

                <Label
                    Content="登录"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="20"
                    Content="|"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Content="注册"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
                <Label
                    Width="20"
                    MouseDown="Label_MouseDown"
                    Style="{StaticResource labelSty}" />
            </WrapPanel>

        </WrapPanel>

        <!--  保持宽高比放大到整个父容器  -->
        <!--  Stretch="UniformToFill"  -->
        <!--
            水平方向填满
            HorizontalAlignment="Stretch"
            垂直方向填满
            VerticalAlignment="Stretch"
        -->
        <Image
            Name="image1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Source="/Image/2_风景.bmp"
            Stretch="UniformToFill" />
    </Grid>
</Window>
