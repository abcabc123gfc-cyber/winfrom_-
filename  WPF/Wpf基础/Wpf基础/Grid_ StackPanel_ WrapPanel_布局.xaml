<Window
    x:Class="Wpf基础.Grid__StackPanel__WrapPanel_布局"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Wpf基础"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Grid__StackPanel__WrapPanel_布局"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <!--  Grid 网格布局控件  可以把空间划分成行和列,来放置子控件  -->
    <Grid>
        <!--  行和列的定义  -->
        <Grid.ColumnDefinitions>
            <!--  这一列的宽度按比例占用“剩余空间”，也就是常说的“星号尺寸”或“自适应拉伸”。  -->
            <!--
                定义一列 可以单独设置每一列的宽度  可以设置成固定的值 100 200
                也可以设置成自适应的值 *  也可以设置成自适应的值 2* 3* 4* 5* 6* 7* 8* 9* 10*
            -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Grid.Row="0" Grid.Column="0"  设置控件显示的位置  -->
        <Button
            Grid.Row="0"
            Grid.Column="0"
            Width="50"
            Height="40"
            HorizontalAlignment="Center"
            Click="Button_Click">
            按钮1
        </Button>
        <Label
            Grid.Row="0"
            Grid.Column="1"
            Content="标签1" />

        <Border
            Grid.Row="0"
            Grid.Column="2"
            BorderBrush="Red"
            BorderThickness="3">
            <Border.Child>
                <WrapPanel>
                    <Label Content="标签2" />
                    <Button
                        Width="50"
                        Height="40"
                        HorizontalAlignment="Center">
                        按钮2
                    </Button>
                    <!--  画圆  -->
                    <Ellipse
                        x:Name="ellipes"
                        Width="30"
                        Height="30"
                        Fill="Red" />
                    <!--  画矩形  -->
                    <Rectangle
                        x:Name="rectangle"
                        Width="50"
                        Height="50"
                        Fill="Red" />
                </WrapPanel>

            </Border.Child>
        </Border>
    </Grid>
    <!--
        StackPanel 和 WrapPanel 都是布局控件,可以把子控件放在里面,
        但是 StackPanel 是堆栈布局,只能水平或者垂直排列,而 WrapPanel 是包裹布局,可以自动换行排列
    -->

</Window>
