<Window
    x:Class="MVVM_Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MVVM_Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MVVM_Demo.ViewModels"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="ControlSty" TargetType="{x:Type Control}">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style
            x:Key="textSty"
            BasedOn="{StaticResource ControlSty}"
            TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style
            x:Key="ButtonSty"
            BasedOn="{StaticResource ControlSty}"
            TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="20,0" />
        </Style>
        <Style x:Key="DataGridCellTextStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="DataGridCellButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0">
            <Label
                VerticalAlignment="Center"
                BorderThickness="0"
                Content="按姓名查询" />
            <TextBox Style="{StaticResource textSty}" />
            <Button Content="查询" Style="{StaticResource ButtonSty}" />
            <Button
                Command="{Binding AddCommand}"
                Content="添加"
                Style="{StaticResource ButtonSty}" />
            <Button Content="更新" Style="{StaticResource ButtonSty}" />
            <Button Content="删除" Style="{StaticResource ButtonSty}" />
        </WrapPanel>
        <!--  表格  -->
        <DataGrid
            Grid.Row="1"
            AlternatingRowBackground="LightBlue"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding Students}">
            <!--  RowHeaderStyle —— 控制左侧那一列  -->
            <DataGrid.RowHeaderStyle>
                <Style TargetType="DataGridRowHeader">

                    <Setter Property="Width" Value="10" />
                </Style>
            </DataGrid.RowHeaderStyle>
            <!--  ColumnHeaderStyle —— 控制顶部那一行  -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <!--  设置行样式  -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="40" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!--  绑定列  -->
                <DataGridTemplateColumn Width="*" Header="编号">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource DataGridCellTextStyle}" Text="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--  绑定列  -->
                <DataGridTemplateColumn Width="*" Header="姓名">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource DataGridCellTextStyle}" Text="{Binding Name}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--  绑定列  -->
                <DataGridTemplateColumn Width="*" Header="年龄">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource DataGridCellTextStyle}" Text="{Binding Age}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!--  列中定义按钮  -->
                <DataGridTemplateColumn Width="*" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--
                                    修改按钮（MVVM 命令绑定）
                                    
                                    1. Command：
                                    按钮所在的 DataGrid/ListBox 行模板中，按钮自身的 DataContext 通常是“当前行数据”，
                                    而不是外层的 ViewModel。
                                    所以这里用 RelativeSource 向上查找 Window，
                                    再取 Window.DataContext 中的 ModifyCommand。
                                    
                                    等价于：
                                    ((MainViewModel)Window.DataContext).ModifyCommand
                                    
                                    2. CommandParameter：
                                    绑定当前行数据的 Id。
                                    点击按钮时，会把当前行的 Id 作为参数传给 ModifyCommand。
                                    
                                    3. 整体效果：
                                    点击“修改”按钮 -> 调用外层 ViewModel 的 ModifyCommand ->
                                    把当前行数据的 Id 传进去，由 ViewModel 根据 Id 执行修改逻辑。
                                -->
                                <Button
                                    Command="{Binding DataContext.ModifyCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding Id}"
                                    Content="修改" />
                                <!--
                                    DataContext.DeleteCommand 数据上下文的命名 指的是windows的上下文
                                    直接写DeleteCommand 默认是从DataGrid控件的DataContext去找DeleteCommand
                                    但是DataGrid控件的DataContext中没有 DeleteCommand 所以报错
                                    RelativeSource 相对资源   FindAncestor查找祖先   AncestorType的类型
                                -->
                                <Button
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                    CommandParameter="{Binding Id}"
                                    Content="删除" />
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
