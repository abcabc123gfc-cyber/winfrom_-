<Window
    x:Class="WPF项目.Views.AddEditStoreArea"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WPF项目.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF项目.ViewModels"
    Title="AddEditStoreArea"
    Width="800"
    Height="600"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:UserControlStroreAreaViewModel />
    </Window.DataContext>
    <Grid Background="#F5F6F8">

        <!--  外层 Border 整体包裹  -->
        <Border
            Width="540"
            Padding="28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>

                <!--  标题  -->
                <TextBlock
                    Margin="0,0,0,18"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="{Binding Title}" />

                <!--  ================= 表单：竖着排列 =================  -->

                <!--  仓库区域编号 StoreAreaNo  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="区域编号" />
                        <TextBox
                            x:Name="txtStoreAreaNo"
                            Grid.Column="1"
                            MaxLength="50"
                            Text="{Binding StoreAreaNo}"
                            ToolTip="必填，仓库区域编号，如 A-01" />
                    </Grid>
                </Border>

                <!--  仓库区域名称 StoreAreaName  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="区域名称" />
                        <TextBox
                            x:Name="txtStoreAreaName"
                            Grid.Column="1"
                            MaxLength="50"
                            Text="{Binding StoreAreaName}"
                            ToolTip="必填，仓库区域名称" />
                    </Grid>
                </Border>

                <!--  所属仓库 StoreId  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="所属仓库" />
                        <ComboBox
                            x:Name="cboStoreId"
                            Grid.Column="1"
                            DisplayMemberPath="Key"
                            IsEditable="False"
                            ItemsSource="{Binding dicStorePlace}"
                            SelectedIndex="0"
                            SelectedValue="{Binding StoreId}"
                            SelectedValuePath="Value"
                            ToolTip="必填，选择所属仓库" />
                    </Grid>
                </Border>

                <!--  当前温度 Temperature  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前温度" />
                        <TextBox
                            x:Name="txtTemperature"
                            Grid.Column="1"
                            Text="{Binding Temperature}"
                            ToolTip="必填，单位为 ℃" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#999999"
                            Text="℃" />
                    </Grid>
                </Border>

                <!--  最小温度 MinTemperature  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最小温度" />
                        <TextBox
                            x:Name="txtMinTemperature"
                            Grid.Column="1"
                            Text="{Binding MinTemperature}"
                            ToolTip="必填，低于该值触发低预警，单位为 ℃" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#999999"
                            Text="℃" />
                    </Grid>
                </Border>

                <!--  最大温度 MaxTemperature  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="101*" />
                            <ColumnDefinition Width="234*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大温度" />
                        <TextBox
                            x:Name="txtMaxTemperature"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Text="{Binding MaxTemperature}"
                            ToolTip="必填，高于该值触发高预警，单位为 ℃" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="15,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#999999"
                            Text="℃" />
                    </Grid>
                </Border>

                <!--  温度状态 TemperatureStatus（0 正常，1 高预警，2 低预警）  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="温度状态" />
                        <ComboBox
                            x:Name="cboTemperatureStatus"
                            Grid.Column="1"
                            DisplayMemberPath="Key"
                            ItemsSource="{Binding dicTemperatureStatus}"
                            SelectedIndex="0"
                            SelectedValue="{Binding TemperatureStatus}"
                            SelectedValuePath="Value" />
                    </Grid>
                </Border>

                <!--  状态 Status（0 正常，1 禁用）  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" />
                        <ComboBox
                            x:Name="cboStatus"
                            Grid.Column="1"
                            DisplayMemberPath="Key"
                            ItemsSource="{Binding dicUserState}"
                            SelectedIndex="0"
                            SelectedValue="{Binding Status}"
                            SelectedValuePath="Value" />
                    </Grid>
                </Border>

                <!--  备注 Remark  -->
                <Border BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="134*" />
                            <ColumnDefinition Width="229*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,8,12,0"
                            VerticalAlignment="Top"
                            Text="备注" />
                        <TextBox
                            x:Name="txtRemark"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="76"
                            Padding="8,6"
                            AcceptsReturn="True"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            FontSize="14"
                            MaxLength="500"
                            Text="{Binding Remark}"
                            TextWrapping="Wrap"
                            ToolTip="选填，备注信息"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!--  ================= 底部按钮 =================  -->
                <StackPanel
                    Margin="0,26,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="btnAdd"
                        Width="96"
                        Height="34"
                        Margin="0,0,16,0"
                        Background="#2D8CF0"
                        BorderThickness="0"
                        Command="{Binding AddCommand}"
                        Content="{Binding Buttontext}"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White" />

                    <Button
                        x:Name="btnCancel"
                        Width="96"
                        Height="34"
                        Background="#FFFFFF"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        Content="取消"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="#333333"
                        IsCancel="True" />
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</Window>
