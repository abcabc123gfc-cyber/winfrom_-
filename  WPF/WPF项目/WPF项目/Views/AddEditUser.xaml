<Window
    x:Class="WPF项目.Views.AddEditUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Helper="clr-namespace:WPF项目.Share"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF项目.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF项目.ViewModels"
    Title="AddEditUser"
    Width="350"
    Height="500"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:AddEditUserViewModel />
    </Window.DataContext>
    <Grid Margin="20">

        <!--  ===== 一个 Border 包裹整个表单 =====  -->
        <Border
            Padding="24"
            Background="White"
            BorderBrush="#E0E4E8"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!--  标题  -->
                    <RowDefinition Height="*" />
                    <!--  表单  -->
                    <RowDefinition Height="Auto" />
                    <!--  底部按钮  -->
                </Grid.RowDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,20"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="{Binding Title}" />

                <!--  表单：竖向排列，每个字段 标签在上 / 内容在下  -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!--  账号  -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="账号" />
                            <TextBox
                                Height="34"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                Text="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  密码  -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="密码" />
                            <PasswordBox
                                Height="34"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                Helper:PasswordBoxHelper.Attach="True"
                                Helper:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!--  用户类型  -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="用户类型" />
                            <ComboBox
                                Height="34"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Key"
                                ItemsSource="{Binding dicUserType}"
                                SelectedValue="{Binding UserTypeId, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>

                        <!--  状态  -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="状态" />
                            <ComboBox
                                Height="34"
                                VerticalContentAlignment="Center"
                                DisplayMemberPath="Key"
                                ItemsSource="{Binding dicUserState}"
                                SelectedValue="{Binding Status, Mode=TwoWay}"
                                SelectedValuePath="Value" />
                        </StackPanel>

                        <!--  备注  -->
                        <!--  UpdateSourceTrigger 默认值是 LostFocus（失去焦点才更新）  -->
                        <!--  PropertyChanged 用户每敲一个字符就立即写回 Remark  -->
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,6"
                                FontWeight="SemiBold"
                                Text="备注" />
                            <TextBox
                                Height="90"
                                Padding="6,4"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!--  底部按钮：添加 / 取消  -->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="110"
                        Height="36"
                        Margin="0,0,12,0"
                        Command="{Binding AddCommand}"
                        Content="{Binding Buttontext}"
                        IsDefault="True" />
                    <Button
                        Width="110"
                        Height="36"
                        Content="取消"
                        IsCancel="True" />
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
