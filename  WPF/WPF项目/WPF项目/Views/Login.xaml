<Window
    x:Class="WPF项目.Views.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Helper="clr-namespace:WPF项目.Share"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF项目.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF项目.ViewModels"
    Title="Login"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="ButtonSty" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="30" />

        </Style>

    </Window.Resources>
    <!--  默认值会生效  -->
    <!--<Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>-->
    <Grid>
        <Border
            Width="250"
            Height="200"
            Margin="100"
            Padding="10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Panel.ZIndex="10"
            BorderBrush="Gray"
            BorderThickness="3"
            CornerRadius="10">
            <Grid Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="用户"
                    Style="{StaticResource labelSty}" />
                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="密码"
                    Style="{StaticResource labelSty}" />
                <!--  ItemsSource="{Binding Users}"  -->
                <!--  SelectedItem="{Binding Account}"  -->
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="20"
                    IsEditable="True"
                    ItemsSource="{Binding UsersName}"
                    Text="{Binding Account}" />

                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Height="20"
                    Helper:PasswordBoxHelper.Attach="True"
                    Helper:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Password="123" />
                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Width="80"
                    Margin="5,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#3DA0FE"
                    Command="{Binding LoginCommand}"
                    Content="登录"
                    Foreground="White" />
                <Button
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Width="80"
                    Margin="5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#3DA0FE"
                    Content="注册"
                    Command="{Binding RegisterCommand}"
                    Foreground="White" />
                <Label
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Width="90"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Bottom"
                    Panel.ZIndex="11"
                    Background="Transparent"
                    BorderThickness="0"
                    Content="{Binding LabeledText}"
                    Foreground="Red" />
            </Grid>

        </Border>

        <Image Source="/Image/1_风景.bmp" Stretch="UniformToFill" />
    </Grid>
</Window>
