<Window
    x:Class="WPF项目.Views.AddEditStore"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WPF项目.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF项目.ViewModels"
    Title="AddEditStore"
    Width="600"
    Height="450"
    mc:Ignorable="d">
    <Window.DataContext>
        <vm:AddEditStoreViewModel />
    </Window.DataContext>
    <Grid Background="#F5F6F8">

        <!--  外层 Border 整体包裹  -->
        <Border
            Width="520"
            Padding="28,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel>

                <!--  标题  -->
                <TextBlock
                    Margin="0,0,0,18"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="{Binding Title}" />

                <!--  ================= 表单：竖着排列 =================  -->

                <!--  仓库名称 StoreName  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="仓库名称" />
                        <TextBox
                            x:Name="txtStoreName"
                            Grid.Column="1"
                            MaxLength="50"
                            Text="{Binding StoreName}"
                            ToolTip="必填，仓库名称" />
                    </Grid>
                </Border>

                <!--  仓库位置 StorePlace  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="仓库位置" />
                        <TextBox
                            x:Name="txtStorePlace"
                            Grid.Column="1"
                            MaxLength="200"
                            Text="{Binding StorePlace}"
                            ToolTip="选填，仓库位置" />
                    </Grid>
                </Border>

                <!--  分区数 AreaCount  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="分区数" />
                        <TextBox
                            x:Name="txtAreaCount"
                            Grid.Column="1"
                            MaxLength="9"
                            Text="{Binding AreaCount}"
                            ToolTip="默认 1" />
                    </Grid>
                </Border>

                <!--  状态 Status（0 正常，1 禁用）  -->
                <Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="57*" />
                            <ColumnDefinition Width="24*" />
                            <ColumnDefinition Width="271*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="状态" />
                        <ComboBox
                            x:Name="cboStatus"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            DisplayMemberPath="Key"
                            ItemsSource="{Binding dicUserState}"
                            SelectedIndex="0"
                            SelectedValue="{Binding Status, Mode=TwoWay}"
                            SelectedValuePath="Value" />
                    </Grid>
                </Border>

                <!--  备注 Remark  -->
                <Border BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="69*" />
                            <ColumnDefinition Width="283*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,8,12,0"
                            VerticalAlignment="Top"
                            Text="备注" />
                        <TextBox
                            x:Name="txtRemark"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="80"
                            Padding="8,6"
                            AcceptsReturn="True"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            FontSize="14"
                            MaxLength="500"
                            Text="{Binding Remark}"
                            TextWrapping="Wrap"
                            ToolTip="选填，备注信息"
                            VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>

                <!--  ================= 底部按钮 =================  -->
                <StackPanel
                    Margin="0,26,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="btnAdd"
                        Width="96"
                        Height="34"
                        Margin="0,0,16,0"
                        Background="#2D8CF0"
                        BorderThickness="0"
                        Command="{Binding AddCommand}"
                        Content="{Binding Buttontext}"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="White" />

                    <Button
                        x:Name="btnCancel"
                        Width="96"
                        Height="34"
                        Background="#FFFFFF"
                        BorderBrush="#D9D9D9"
                        BorderThickness="1"
                        Content="取消"
                        Cursor="Hand"
                        FontSize="14"
                        Foreground="#333333"
                        IsCancel="True" />
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
