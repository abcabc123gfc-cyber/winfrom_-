<Window
    x:Class="RegionAndNavigation.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    Title="{Binding Title}"
    Width="525"
    Height="350"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            BorderBrush="red"
            BorderThickness="2">
            <WrapPanel>
                <TextBlock Text="XXXX管理系统" />

                <Button Command="{Binding BackCommand}" Content="后退" />
                <Button Command="{Binding ForwardCommand}" Content="前进" />
                <Button Command="{Binding ClearCommand}" Content="清空" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>


            <Border
                Grid.Column="0"
                BorderBrush="Yellow"
                BorderThickness="2">
                <StackPanel>
                    <Button
                        Width="150"
                        Height="30"
                        Command="{Binding OpenCommand}"
                        CommandParameter="ViewA"
                        Content="跳转到ViewA" />
                    <Button
                        Width="150"
                        Height="30"
                        Command="{Binding OpenCommand}"
                        CommandParameter="ViewB"
                        Content="跳转到ViewB" />
                    <Button
                        Width="150"
                        Height="30"
                        Command="{Binding OpenCommand}"
                        CommandParameter="ViewC"
                        Content="跳转到ViewC" />
                </StackPanel>
                <!--  把控件本身当作参数传递到对应的Command命令中  -->
                <!--<StackPanel>
                  <Button
                      Width="150"
                      Height="30"
                      Command="{Binding OpenCommand1}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                      Content="ViewA" />
                  <Button
                      Width="150"
                      Height="30"
                      Command="{Binding OpenCommand1}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                      Content="ViewB" />
                  <Button
                      Width="150"
                      Height="30"
                      Command="{Binding OpenCommand1}"
                      CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                      Content="ViewC" />
              </StackPanel>-->
            </Border>
            <Border
                Grid.Column="1"
                BorderBrush="Blue"
                BorderThickness="2">
                <ContentControl prism:RegionManager.RegionName="ContentRegion" />
            </Border>
        </Grid>



    </Grid>
</Window>
