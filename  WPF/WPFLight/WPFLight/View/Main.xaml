<Window
    x:Class="WPFLight.View.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFLight.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Main"
    Width="800"
    Height="450"
    DataContext="{Binding Source={StaticResource Locator}, Path=Main}"
    mc:Ignorable="d">

    <DockPanel>
        <WrapPanel Height="50" DockPanel.Dock="Top">
            <Label
                Width="70"
                HorizontalAlignment="Left"
                Content="管理界面" />
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <Label Content="当前用户: " />
                <TextBox Width="60" Text="{Binding UserName}" />
                <Button
                    Margin="40,0"
                    Command="{Binding LogoutCommand}"
                    Content="注销" />
            </WrapPanel>
        </WrapPanel>
        <StackPanel
            Width="100"
            Height="350"
            DockPanel.Dock="Left">
            <Border
                Height="350"
                BorderBrush="Gray"
                BorderThickness="1">
                <StackPanel>
                    <Button
                        Command="{Binding UserCommand}"
                        CommandParameter="UserControlUserInfo"
                        Content="用户管理" />
                    <Button Command="{Binding BlogCommand}" Content="博客管理" CommandParameter="UserControlBlog" />

                </StackPanel>

            </Border>

        </StackPanel>
        <StackPanel Panel.ZIndex="5" DockPanel.Dock="Bottom">
            <Button Command="{Binding StopCommand}" Content="停止" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right">
            <UserControl x:Name="UserControl" Content="{Binding UC}" />
        </StackPanel>
    </DockPanel>


</Window>
