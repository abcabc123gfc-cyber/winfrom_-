<UserControl
    x:Class="WPFLight.View.UserControls.UserControlUserInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFLight.View.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding Source={StaticResource Locator}, Path=UserInfo}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            ItemsSource="{Binding DataInfo}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="编号">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Text="{Binding Id}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="账号">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Text="{Binding Account}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="*" Header="密码">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Text="{Binding Password}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="160" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button
                                    Width="60"
                                    Height="30"
                                    Command="{Binding DataContext.AddEditCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                    CommandParameter="{Binding BlogId}">
                                    修改
                                </Button>
                                <Button
                                    Width="60"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"
                                    CommandParameter="{Binding BlogId}">
                                    删除
                                </Button>
                            </WrapPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!--  这三个按钮的 DataContext 已经是 ViewModel，直接绑命令名  -->
        <WrapPanel Grid.Row="1" VerticalAlignment="Center">
            <Button
                Width="80"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding HeaderCommand}">
                首页
            </Button>
            <Button
                Width="80"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding UpCommand}">
                上一页
            </Button>
            <Button
                Width="80"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding NextCommand}">
                下一页
            </Button>
            <Button
                Width="80"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding EndCommand}">
                尾页
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
