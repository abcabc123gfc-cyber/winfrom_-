<Window
    x:Class="_01_基础使用.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:_01_基础使用"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <StackPanel>
        <WrapPanel>
            <Label Content="姓名" />
            <TextBox Width="150" Text="{Binding Name}" />
        </WrapPanel>
        <WrapPanel>
            <Label Content="年龄" />
            <TextBox Width="150" Text="{Binding Age}" />
        </WrapPanel>


        <Button Command="{Binding FirstCommand}">无参命令</Button>
        <Button Command="{Binding SecondCommand}" CommandParameter="aaa">有参命令</Button>
        <Button Command="{Binding FirstAsyncCommand}">异步无参命令</Button>
        <Button Command="{Binding SecondAsyncCommand}" CommandParameter="aaa">异步有参命令</Button>

        <DataGrid ItemsSource="{Binding Users}" />

    </StackPanel>
</Window>
