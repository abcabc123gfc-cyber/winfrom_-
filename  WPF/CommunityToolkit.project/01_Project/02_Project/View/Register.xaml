<Window x:Class="_02_Project.View.Register"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="用户注册"
        Width="420" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        mc:Ignorable="d">

    <Grid>
        <!-- 居中卡片 -->
        <Border Width="340"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="12"
                Padding="30,26">
            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="24" ShadowDepth="0" Opacity="0.15" />
            </Border.Effect>

            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="用户注册"
                           FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- 用户名 -->
                <TextBlock Text="用户名" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox Height="38" Padding="8,0" VerticalContentAlignment="Center"
                         Text="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 密码 -->
                <TextBlock Text="密码" FontSize="13" Foreground="#666" Margin="0,14,0,4"/>
                <PasswordBox x:Name="PwdBox" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                             PasswordChanged="PwdBox_PasswordChanged"/>

                <!-- 确认密码 -->
                <TextBlock Text="确认密码" FontSize="13" Foreground="#666" Margin="0,14,0,4"/>
                <PasswordBox x:Name="ConfirmPwdBox" Height="38" Padding="8,0" VerticalContentAlignment="Center"
                             PasswordChanged="ConfirmPwdBox_PasswordChanged"/>

                <!-- 错误提示 -->
                <TextBlock Foreground="#E74C3C" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 注册按钮 -->
                <Button Height="40" Margin="0,18,0,0"
                        Background="#67C23A" Foreground="White" BorderThickness="0"
                        Command="{Binding RegisterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="注 册"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="注册中..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 返回登录 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="已有账号？" Foreground="#888" VerticalAlignment="Center"/>
                    <Button Content="返回登录" Command="{Binding BackToLoginCommand}"
                            Cursor="Hand" Foreground="#409EFF" FontWeight="Medium"
                            BorderThickness="0" Background="Transparent" Padding="4,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
