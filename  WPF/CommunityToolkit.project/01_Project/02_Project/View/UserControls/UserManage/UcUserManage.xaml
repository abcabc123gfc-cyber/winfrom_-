<UserControl x:Class="_02_Project.View.UserControls.UserManage.UcUserManage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding LoadCommand}" />
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 页面标题 -->
            <RowDefinition Height="Auto" />  <!-- 工具栏 -->
            <RowDefinition Height="Auto" />  <!-- 编辑表单 -->
            <RowDefinition Height="*" />     <!-- 表格 + 分页 -->
        </Grid.RowDefinitions>

        <!-- ===== 页面标题 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="用户管理" FontSize="20" FontWeight="SemiBold" Foreground="#303133" />
            <TextBlock Text="（系统用户账号管理）" FontSize="12" Foreground="#909399"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
        </StackPanel>

        <!-- ===== 工具栏：查询ID + 添加/修改/导入/导出Excel ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12,10"
                BorderBrush="#E4E7ED" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：查询ID -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="用户ID：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                    <TextBox Width="140" Height="32" VerticalContentAlignment="Center"
                             Text="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="QueryIdBox_PreviewTextInput" />
                    <Button Content="查询" Margin="8,0,0,0" Padding="16,6" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding QueryCommand}" />
                    <Button Content="重置" Margin="8,0,0,0" Padding="16,6" Background="#909399"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ResetCommand}" />
                    <TextBlock Text="{Binding HintText}" Foreground="#E6A23C" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- 右侧：操作按钮（权限：仅管理员可用） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加" Width="88" Height="32" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding AddCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="修改" Width="88" Height="32" Margin="8,0,0,0" Background="#E6A23C"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding EditCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="导入" Width="88" Height="32" Margin="8,0,0,0" Background="#67C23A"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding ImportCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="导出Excel" Width="96" Height="32" Margin="8,0,0,0" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 编辑表单（默认隐藏；新增必填密码，修改密码留空表示不修改） ===== -->
        <Border Grid.Row="2" Background="#FFF7E6" CornerRadius="6" Padding="12,10"
                BorderBrush="#FAE3C4" BorderThickness="1" Margin="0,10,0,10"
                Visibility="{Binding EditPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="账号：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2" Text="密码：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <PasswordBox x:Name="PwdBox" Width="120" Height="32" VerticalContentAlignment="Center"
                                 PasswordChanged="PwdBox_PasswordChanged" />
                    <TextBlock Text="{Binding PwdHintText}" FontSize="11" Foreground="#E6A23C"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="用户类型：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Grid.Column="5" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding TypeOptions}"
                          DisplayMemberPath="UserTypeName" SelectedValuePath="UserTypeId"
                          SelectedValue="{Binding SelectedTypeId}" />

                <TextBlock Grid.Column="6" Text="状态：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Grid.Column="7" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding StatusOptions}"
                          DisplayMemberPath="Text" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedStatus}" />

                <TextBlock Grid.Column="8" Text="备注：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Grid.Column="9" Height="32" VerticalContentAlignment="Center" Margin="0,0,16,0"
                         Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存" Width="80" Height="32" Background="#67C23A"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding SaveCommand}" />
                    <Button Content="取消" Width="80" Height="32" Margin="8,0,0,0" Background="#909399"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 数据表格 + 分页 ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E4E7ED" Background="White"
                      RowHeight="40" Margin="0,0,0,8"
                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Width="60" Binding="{Binding Index}" />
                    <DataGridTextColumn Header="用户ID" Width="90" Binding="{Binding UserId}" />
                    <DataGridTextColumn Header="账号" Width="150" Binding="{Binding Account}" />
                    <DataGridTextColumn Header="用户类型" Width="110" Binding="{Binding UserTypeName}" />
                    <DataGridTextColumn Header="状态" Width="90" Binding="{Binding StatusText}" />
                    <DataGridTextColumn Header="创建时间" Width="150"
                                        Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm}" />
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Remark}" />
                    <DataGridTemplateColumn Header="操作" Width="150" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="修改"
                                            Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,4" FontSize="12" Background="#409EFF"
                                            Foreground="White" BorderThickness="0" />
                                    <Button Content="删除"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="8,0,0,0" Padding="10,4" FontSize="12" Background="#E74C3C"
                                            Foreground="White" BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 分页 -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding TotalText}" FontSize="12"
                           Foreground="#909399" VerticalAlignment="Center" />
                <hc:Pagination DockPanel.Dock="Right"
                               MaxPageCount="{Binding MaxPageCount, Mode=OneWay}"
                               PageIndex="{Binding PageIndex, Mode=TwoWay}"
                               DataCountPerPage="10"
                               IsJumpEnabled="True">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
