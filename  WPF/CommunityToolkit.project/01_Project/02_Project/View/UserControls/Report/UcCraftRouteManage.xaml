<UserControl x:Class="_02_Project.View.UserControls.Report.UcCraftRouteManage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding LoadCommand}" />
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页面标题 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="工艺路线管理" FontSize="20" FontWeight="SemiBold" Foreground="#303133" />
            <TextBlock Text="（报工管理 - 工艺路线管理）" FontSize="12" Foreground="#909399"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
        </StackPanel>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12,10"
                BorderBrush="#E4E7ED" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="路线ID：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                    <TextBox Width="140" Height="32" VerticalContentAlignment="Center"
                             Text="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="QueryIdBox_PreviewTextInput" />
                    <Button Content="查询" Margin="8,0,0,0" Padding="16,6" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding QueryCommand}" />
                    <Button Content="重置" Margin="8,0,0,0" Padding="16,6" Background="#909399"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ResetCommand}" />
                    <TextBlock Text="{Binding HintText}" Foreground="#E6A23C" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加" Width="88" Height="32" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding AddCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="修改" Width="88" Height="32" Margin="8,0,0,0" Background="#E6A23C"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding EditCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="导出Excel" Width="96" Height="32" Margin="8,0,0,0" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 编辑表单（默认隐藏）：基础字段 + 工艺流程子表单 ===== -->
        <Border Grid.Row="2" Background="#FFF7E6" CornerRadius="6" Padding="12,10"
                BorderBrush="#FAE3C4" BorderThickness="1" Margin="0,10,0,10"
                Visibility="{Binding EditPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：基础字段 -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="路线编号：" FontSize="13" Foreground="#606266"
                                   VerticalAlignment="Center" Width="86" />
                        <TextBox Width="220" Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding RouteNo, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="工艺名称：" FontSize="13" Foreground="#606266"
                                   VerticalAlignment="Center" Width="86" />
                        <TextBox Width="220" Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding RouteName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="成品名称：" FontSize="13" Foreground="#606266"
                                   VerticalAlignment="Center" Width="86" />
                        <TextBox Width="220" Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="备注：" FontSize="13" Foreground="#606266"
                                   VerticalAlignment="Center" Width="86" />
                        <TextBox Width="220" Height="32" VerticalContentAlignment="Center"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="86,0,0,0">
                        <Button Content="保存" Width="80" Height="32" Background="#67C23A"
                                Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding SaveCommand}" />
                        <Button Content="取消" Width="80" Height="32" Margin="8,0,0,0" Background="#909399"
                                Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- 右：工艺流程子表单（工序 + 顺序 + 备注） -->
                <Border Grid.Column="1" Background="White" CornerRadius="4" BorderBrush="#E4E7ED" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                            <TextBlock Text="工艺流程（子表单）" FontSize="13" FontWeight="SemiBold" Foreground="#303133"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="工序按顺序从小到大执行" FontSize="11" Foreground="#909399"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="添加行" Width="70" Height="26" Margin="16,0,0,0" Background="#409EFF"
                                    Foreground="White" BorderThickness="0" FontSize="12" Command="{Binding AddDetailCommand}" />
                            <Button Content="删除选中行" Width="86" Height="26" Margin="8,0,0,0" Background="#E74C3C"
                                    Foreground="White" BorderThickness="0" FontSize="12" Command="{Binding RemoveDetailCommand}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" Margin="8,0,8,8"
                                  AutoGenerateColumns="False" SelectionMode="Single"
                                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E4E7ED"
                                  RowHeight="36" CanUserAddRows="False"
                                  ItemsSource="{Binding Details}" SelectedItem="{Binding SelectedDetail}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="工序" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.ProcessOptions, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                      DisplayMemberPath="Text" SelectedValuePath="Id"
                                                      SelectedValue="{Binding ProcessId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      BorderThickness="0" Background="Transparent" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="顺序" Width="70"
                                                    Binding="{Binding SortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="备注" Width="2*"
                                                    Binding="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 数据表格 + 分页 ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E4E7ED" Background="White"
                      RowHeight="40" Margin="0,0,0,8"
                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Index}" />
                    <DataGridTextColumn Header="路线ID" Width="80" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="工艺路线编号" Width="130" Binding="{Binding RouteNo}" />
                    <DataGridTextColumn Header="工艺名称" Width="150" Binding="{Binding RouteName}" />
                    <DataGridTextColumn Header="成品名称" Width="150" Binding="{Binding ProductName}" />
                    <DataGridTextColumn Header="工序数" Width="80" Binding="{Binding DetailCount}" />
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Remark}" />
                    <DataGridTemplateColumn Header="操作" Width="150" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="修改"
                                            Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,4" FontSize="12" Background="#409EFF"
                                            Foreground="White" BorderThickness="0" />
                                    <Button Content="删除"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="8,0,0,0" Padding="10,4" FontSize="12" Background="#E74C3C"
                                            Foreground="White" BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 分页 -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding TotalText}" FontSize="12"
                           Foreground="#909399" VerticalAlignment="Center" />
                <hc:Pagination DockPanel.Dock="Right"
                               MaxPageCount="{Binding MaxPageCount, Mode=OneWay}"
                               PageIndex="{Binding PageIndex, Mode=TwoWay}"
                               DataCountPerPage="10"
                               IsJumpEnabled="True">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
