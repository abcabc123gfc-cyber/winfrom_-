<UserControl x:Class="_02_Project.View.UserControls.Report.UcWageSettingManage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="#F0F2F5">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding LoadCommand}" />
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页面标题 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="工价管理" FontSize="20" FontWeight="SemiBold" Foreground="#303133" />
            <TextBlock Text="（报工管理 - 工价管理）" FontSize="12" Foreground="#909399"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
        </StackPanel>

        <!-- ===== 工具栏 ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12,10"
                BorderBrush="#E4E7ED" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="工价ID：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                    <TextBox Width="110" Height="32" VerticalContentAlignment="Center"
                             Text="{Binding QueryId, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="QueryIdBox_PreviewTextInput" />
                    <TextBlock Text="工序：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ComboBox Width="130" Height="32" VerticalContentAlignment="Center"
                              ItemsSource="{Binding FilterProcessOptions}"
                              DisplayMemberPath="Text" SelectedValuePath="Id"
                              SelectedValue="{Binding FilterProcessId}" />
                    <Button Content="查询" Margin="8,0,0,0" Padding="16,6" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding QueryCommand}" />
                    <Button Content="重置" Margin="8,0,0,0" Padding="16,6" Background="#909399"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ResetCommand}" />
                    <TextBlock Text="{Binding HintText}" Foreground="#E6A23C" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="添加" Width="88" Height="32" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding AddCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="修改" Width="88" Height="32" Margin="8,0,0,0" Background="#E6A23C"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding EditCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="导入" Width="88" Height="32" Margin="8,0,0,0" Background="#67C23A"
                            Foreground="White" BorderThickness="0" FontSize="13"
                            Command="{Binding ImportCommand}" IsEnabled="{Binding IsAdmin}" />
                    <Button Content="导出Excel" Width="96" Height="32" Margin="8,0,0,0" Background="#409EFF"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ExportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 编辑表单（默认隐藏） ===== -->
        <Border Grid.Row="2" Background="#FFF7E6" CornerRadius="6" Padding="12,10"
                BorderBrush="#FAE3C4" BorderThickness="1" Margin="0,10,0,10"
                Visibility="{Binding EditPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="工价名称：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2" Text="选择工序：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Grid.Column="3" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ProcessOptions}"
                          DisplayMemberPath="Text" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedProcessId}" />

                <TextBlock Grid.Column="4" Text="单价(元/件)：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Grid.Column="5" Height="32" VerticalContentAlignment="Center"
                         Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewTextInput="TxtUnitPrice_PreviewTextInput" />

                <TextBlock Grid.Column="6" Text="工价说明：" FontSize="13" Foreground="#606266"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox Grid.Column="7" Height="32" VerticalContentAlignment="Center" Margin="0,0,16,0"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存" Width="80" Height="32" Background="#67C23A"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding SaveCommand}" />
                    <Button Content="取消" Width="80" Height="32" Margin="8,0,0,0" Background="#909399"
                            Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 数据表格 + 分页 ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E4E7ED" Background="White"
                      RowHeight="40" Margin="0,0,0,8"
                      ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Width="50" Binding="{Binding Index}" />
                    <DataGridTextColumn Header="工价ID" Width="80" Binding="{Binding Id}" />
                    <DataGridTextColumn Header="工价名称" Width="160" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="工序" Width="150" Binding="{Binding ProcessName}" />
                    <DataGridTextColumn Header="单价(元/件)" Width="120" Binding="{Binding UnitPrice, StringFormat=0.##}" />
                    <DataGridTextColumn Header="工价说明" Width="*" Binding="{Binding Description}" />
                    <DataGridTemplateColumn Header="操作" Width="150" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="修改"
                                            Command="{Binding DataContext.EditRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Padding="10,4" FontSize="12" Background="#409EFF"
                                            Foreground="White" BorderThickness="0" />
                                    <Button Content="删除"
                                            Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Margin="8,0,0,0" Padding="10,4" FontSize="12" Background="#E74C3C"
                                            Foreground="White" BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 分页 -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding TotalText}" FontSize="12"
                           Foreground="#909399" VerticalAlignment="Center" />
                <hc:Pagination DockPanel.Dock="Right"
                               MaxPageCount="{Binding MaxPageCount, Mode=OneWay}"
                               PageIndex="{Binding PageIndex, Mode=TwoWay}"
                               DataCountPerPage="10"
                               IsJumpEnabled="True">
                    <hc:Interaction.Triggers>
                        <hc:EventTrigger EventName="PageUpdated">
                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                        </hc:EventTrigger>
                    </hc:Interaction.Triggers>
                </hc:Pagination>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
