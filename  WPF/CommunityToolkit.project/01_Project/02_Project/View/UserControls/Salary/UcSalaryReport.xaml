<UserControl x:Class="_02_Project.View.UserControls.Salary.UcSalaryReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="640"
             Background="#F0F2F5">

    <hc:Interaction.Triggers>
        <hc:EventTrigger EventName="Loaded">
            <hc:EventToCommand Command="{Binding LoadCommand}" />
        </hc:EventTrigger>
    </hc:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页面标题 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,10">
            <TextBlock Text="薪资统计" FontSize="20" FontWeight="SemiBold" Foreground="#303133" />
            <TextBlock Text="（薪资报表 - 按员工分组，累加报工工资）" FontSize="12" Foreground="#909399"
                       VerticalAlignment="Bottom" Margin="10,0,0,3" />
        </StackPanel>

        <!-- ===== 筛选栏 ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12,10"
                BorderBrush="#E4E7ED" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="开始时间：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" />
                <hc:DateTimePicker Width="150" Height="32" VerticalContentAlignment="Center"
                                   SelectedDateTime="{Binding FilterStart}" />
                <TextBlock Text="结束时间：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" Margin="12,0,0,0" />
                <hc:DateTimePicker Width="150" Height="32" VerticalContentAlignment="Center"
                                   SelectedDateTime="{Binding FilterEnd}" />
                <TextBlock Text="员工：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Width="150" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding EmployeeOptions}"
                          DisplayMemberPath="Text" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedEmployeeId}" />
                <TextBlock Text="工序：" FontSize="13" Foreground="#606266" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ComboBox Width="130" Height="32" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ProcessOptions}"
                          DisplayMemberPath="Text" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedProcessId}" />
                <Button Content="统计" Margin="12,0,0,0" Padding="20,6" Background="#409EFF"
                        Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding QueryCommand}" />
                <Button Content="重置" Margin="8,0,0,0" Padding="16,6" Background="#909399"
                        Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ResetCommand}" />
                <Button Content="导出Excel" Margin="12,0,0,0" Padding="16,6" Background="#67C23A"
                        Foreground="White" BorderThickness="0" FontSize="13" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Border>

        <!-- ===== 汇总 + 表格 ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column"
                      BorderThickness="1" BorderBrush="#E4E7ED" Background="White"
                      RowHeight="40" Margin="0,0,0,8"
                      ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号" Width="60" Binding="{Binding Index}" />
                    <DataGridTextColumn Header="员工ID" Width="90" Binding="{Binding EmployeeId}" />
                    <DataGridTextColumn Header="员工姓名" Width="150" Binding="{Binding EmployeeName}" />
                    <DataGridTextColumn Header="所属工组" Width="200" Binding="{Binding WorkGroupNames}" />
                    <DataGridTextColumn Header="报工次数" Width="100" Binding="{Binding Times}" />
                    <DataGridTextColumn Header="数量合计" Width="100" Binding="{Binding ReportCount}" />
                    <DataGridTextColumn Header="工资合计(元)" Width="*" Binding="{Binding Wage, StringFormat=0.##}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="#F0F9EB" CornerRadius="4" Padding="12,8"
                    BorderBrush="#E1F3D8" BorderThickness="1">
                <TextBlock Text="{Binding TotalText}" FontSize="13" FontWeight="SemiBold" Foreground="#529B2E" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
