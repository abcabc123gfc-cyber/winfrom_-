<Window x:Class="_02_Project.View.Main"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Title="计件工资管理系统"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />   <!-- 顶部标题栏 -->
            <RowDefinition Height="*" />    <!-- 主体：左导航 + 右内容 -->
            <RowDefinition Height="34" />   <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶部标题栏 ===== -->
        <Border Grid.Row="0" Background="#2B3A4A">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Border Width="26" Height="26" CornerRadius="6" Background="#409EFF" Margin="0,0,10,0">
                    <TextBlock Text="&#xe8a5;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                </Border>
                <TextBlock Text="计件工资管理系统" Foreground="White" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航栏（HandyControl SideMenu） -->
            <Border Grid.Column="0" Background="#F5F7FA" BorderBrush="#E4E7ED" BorderThickness="0,0,1,0">
                <hc:SideMenu x:Name="NavMenu"
                             ExpandMode="ShowAll"
                             Background="Transparent"
                             SelectionChanged="NavMenu_SelectionChanged">
                    <!-- 一级：用户管理（一级标题样式：16号加粗深色 + 图标） -->
                    <hc:SideMenuItem Header="用户管理"
                                     FontSize="16" FontWeight="Bold" Foreground="#2B3A4A">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe77b;" FontFamily="Segoe MDL2 Assets" Foreground="#2B3A4A" FontSize="17" />
                        </hc:SideMenuItem.Icon>
                    </hc:SideMenuItem>

                    <!-- 一级：基础设置（二级标题样式：13号常规浅灰 + 左侧缩进，与一级明显区分） -->
                    <hc:SideMenuItem Header="基础设置"
                                     FontSize="16" FontWeight="Bold" Foreground="#2B3A4A">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe713;" FontFamily="Segoe MDL2 Assets" Foreground="#2B3A4A" FontSize="17" />
                        </hc:SideMenuItem.Icon>
                        <hc:SideMenuItem Header="车间管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="生产线管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="员工管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="工组管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="工位管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="工序管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                    </hc:SideMenuItem>

                    <!-- 一级：报工管理 -->
                    <hc:SideMenuItem Header="报工管理"
                                     FontSize="16" FontWeight="Bold" Foreground="#2B3A4A">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe8a5;" FontFamily="Segoe MDL2 Assets" Foreground="#2B3A4A" FontSize="17" />
                        </hc:SideMenuItem.Icon>
                        <hc:SideMenuItem Header="工价管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="工艺路线管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="报工管理" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                    </hc:SideMenuItem>

                    <!-- 一级：薪资报表 -->
                    <hc:SideMenuItem Header="薪资报表"
                                     FontSize="16" FontWeight="Bold" Foreground="#2B3A4A">
                        <hc:SideMenuItem.Icon>
                            <TextBlock Text="&#xe9d5;" FontFamily="Segoe MDL2 Assets" Foreground="#2B3A4A" FontSize="17" />
                        </hc:SideMenuItem.Icon>
                        <hc:SideMenuItem Header="薪资统计" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                        <hc:SideMenuItem Header="业绩统计" FontSize="13" Foreground="#7A8B9C" Margin="14,0,0,0" />
                    </hc:SideMenuItem>
                </hc:SideMenu>
            </Border>

            <!-- 右侧：用户控件窗体 -->
            <Grid Grid.Column="1" Margin="12">
                <ContentControl x:Name="ContentHost" />
            </Grid>
        </Grid>

        <!-- ===== 底部状态栏：当前登录人 + 系统时间 ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E4E7ED" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="当前登录人：" FontSize="12" Foreground="#606266" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUserName}" FontSize="12" Foreground="#303133"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="　|　" FontSize="12" Foreground="#C0C4CC" VerticalAlignment="Center" />
                    <TextBlock x:Name="ClockText" Text="系统时间：--" FontSize="12" Foreground="#606266"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="计件工资管理系统 v1.0" FontSize="12"
                           Foreground="#909399" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
