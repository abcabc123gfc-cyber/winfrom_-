<Window x:Class="_02_Project.View.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="用户登录"
        Width="420" Height="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F2F5"
        mc:Ignorable="d">

    <Grid>
        <!-- 居中卡片 -->
        <Border Width="340"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="White"
                CornerRadius="12"
                Padding="30,26">
            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="24" ShadowDepth="0" Opacity="0.15" />
            </Border.Effect>

            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="用户登录"
                           FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- 用户名 -->
                <TextBlock Text="用户名" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox Height="38"
                         Padding="8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding Account, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Tag="请输入用户名"/>

                <!-- 密码（密文 / 明文 两个控件，根据复选框切换可见性） -->
                <TextBlock Text="密码" FontSize="13" Foreground="#666" Margin="0,14,0,4"/>
                <Grid Height="38">
                    <!-- 明文框（勾选“显示密码”时显示） -->
                    <TextBox VerticalContentAlignment="Center" Padding="8,0"
                             Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShowPwdChk}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 密文框（默认显示）：PasswordBox 本身不支持绑定，
                         在后台代码 PasswordChanged 事件中同步到 ViewModel.Password -->
                    <PasswordBox x:Name="PwdMasked" VerticalContentAlignment="Center" Padding="8,0"
                                 PasswordChanged="PwdMasked_PasswordChanged">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=ShowPwdChk}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>
                </Grid>

                <!-- 显示密码复选框 -->
                <CheckBox x:Name="ShowPwdChk"
                          Content="显示密码"
                          IsChecked="{Binding ShowPassword}"
                          HorizontalAlignment="Left"
                          Margin="0,8,0,0"/>

                <!-- 错误提示：ErrorMessage 为空时自动隐藏 -->
                <TextBlock Foreground="#E74C3C" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="{Binding ErrorMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- 登录按钮 -->
                <Button Height="40" Margin="0,18,0,0"
                        Background="#409EFF" Foreground="White" BorderThickness="0"
                        Command="{Binding LoginCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="登 录"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Content" Value="登录中..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 注册入口 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="还没有账号？" Foreground="#888" VerticalAlignment="Center"/>
                    <Button Content="立即注册" Command="{Binding GoToRegisterCommand}"
                            Cursor="Hand" Foreground="#409EFF" FontWeight="Medium"
                            BorderThickness="0" Background="Transparent" Padding="4,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
